# Trading System Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================================================
# Alpaca API Configuration
# ============================================================================
# Get your API keys from: https://alpaca.markets/
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# Use paper trading URL for testing
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# For live trading (use with caution!)
# ALPACA_BASE_URL=https://api.alpaca.markets

# ============================================================================
# Google Finance API (if needed)
# ============================================================================
GOOGLE_FINANCE_API_KEY=your_google_finance_key_here

# ============================================================================
# Database Configuration (optional)
# ============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/trading_system
# Or SQLite for development
# DATABASE_URL=sqlite:///./trading_system.db

# ============================================================================
# Redis Cache Configuration (optional)
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

LOG_FORMAT=json
# Options: json, text

LOG_FILE=logs/trading_system.log

# ============================================================================
# Application Configuration
# ============================================================================
# Environment: development, staging, production
ENVIRONMENT=development

# Cache directory
CACHE_DIR=.cache

# Data directory
DATA_DIR=data

# ============================================================================
# Trading Configuration
# ============================================================================
# Default risk per trade (as decimal, e.g., 0.02 = 2%)
DEFAULT_RISK_PER_TRADE=0.02

# Default stop loss percentage
DEFAULT_STOP_LOSS_PCT=0.05

# Default take profit percentage
DEFAULT_TAKE_PROFIT_PCT=0.10

# ============================================================================
# Backtesting Configuration
# ============================================================================
# Initial capital for backtesting
BACKTEST_INITIAL_CAPITAL=100000

# Commission per trade (as decimal)
BACKTEST_COMMISSION=0.001

# ============================================================================
# Monitoring Configuration (optional)
# ============================================================================
# Prometheus metrics port
PROMETHEUS_PORT=9090

# Enable metrics collection
ENABLE_METRICS=true

# ============================================================================
# API Rate Limiting
# ============================================================================
# Yahoo Finance rate limit (requests per hour)
YAHOO_RATE_LIMIT=2000

# Alpaca rate limit (requests per minute)
ALPACA_RATE_LIMIT=200

# Google Finance rate limit (requests per minute)
GOOGLE_RATE_LIMIT=100

# ============================================================================
# Feature Flags
# ============================================================================
# Enable ML-based strategies
ENABLE_ML_STRATEGIES=false

# Enable real-time trading
ENABLE_LIVE_TRADING=false

# Enable paper trading
ENABLE_PAPER_TRADING=true

# ============================================================================
# Security
# ============================================================================
# Secret key for encryption (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your_secret_key_here

# ============================================================================
# Development
# ============================================================================
# Enable debug mode
DEBUG=false

# Enable hot reload
HOT_RELOAD=true

# ============================================================================
# Testing
# ============================================================================
# Use mock data for tests
USE_MOCK_DATA=true

# Test data directory
TEST_DATA_DIR=tests/fixtures/data